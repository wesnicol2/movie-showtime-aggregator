#!/usr/bin/env bash
set -euo pipefail

# Frontend: deterministic formatting/linting, strict typing, and production build.
npm run check
npm run typecheck
npm run build

# Python: exact same Ruff/syntax/test gate used before the frontend was added.
ruff check .
ruff format --check .

while IFS= read -r file; do
  python -m py_compile "$file"
done < <(git ls-files '*.py')

python -m pytest tests/ -q
