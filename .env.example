# Copy to .env before `docker compose up -d`. Never commit .env.

# Host ports for the two environments. Pick ports not used by another project.
PROD_PORT=8080
TEST_PORT=8081

# Container timezone.
TZ=America/Phoenix

# Optional. Comma-separated "Theatre Name:FandangoId" values.
# Defaults in code: Arizona Center 24 (AAECS), Esplanade 14 (AAECR),
# Desert Ridge 18 (AAPGJ), Ahwatukee 24 (AACGT).
# AMC_THEATRES=AMC Arizona Center 24:AAECS,AMC DINE-IN Esplanade 14:AAECR,AMC DINE-IN Desert Ridge 18:AAPGJ,AMC Ahwatukee 24:AACGT

# AMC advertised time -> estimated feature start.
AMC_PRESHOW_MINUTES=25

# Cache upstream showtime data so filter changes/reloads do not refetch immediately.
CACHE_TTL_SECONDS=300
