# Copy to .env before `docker compose up -d`. Never commit .env.

# Host ports for the two environments. Pick ports not used by another project.
PROD_PORT=8080
TEST_PORT=8081

# Container timezone.
TZ=America/Phoenix

# Default location when a browser has not saved its own Settings values.
FANDANGO_ZIP_CODE=85004
FANDANGO_RADIUS_MILES=25

# Number of theaters requested per Fandango market page.
FANDANGO_PAGE_LIMIT=50

# Cache upstream showtime data so filter changes/reloads do not refetch immediately.
CACHE_TTL_SECONDS=300
