# Copy to .env before `docker compose up -d`. Never commit .env.

# Host ports for the two environments. Pick ports not used by another project.
PROD_PORT=8080
TEST_PORT=8081

# Container timezone.
TZ=America/Phoenix

# Required for live showtimes. Request a vendor key from AMC's developer portal.
AMC_VENDOR_KEY=

# Optional. Comma-separated "Theatre Name:id" values.
# Defaults in code: Arizona Center 24 (127), Esplanade 14 (99),
# Desert Ridge 18 (190), Ahwatukee 24 (94).
# AMC_THEATRES=AMC Arizona Center 24:127,AMC DINE-IN Esplanade 14:99,AMC DINE-IN Desert Ridge 18:190,AMC Ahwatukee 24:94

# AMC advertised time -> estimated feature start.
AMC_PRESHOW_MINUTES=25

# Avoid burning AMC quota when changing filters/reloading the page.
CACHE_TTL_SECONDS=300
